{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["./opencode-local-agent.md"],

  "provider": {
    "internal-ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Internal AI - Ollama",
      "options": {
        "baseURL": "http://192.168.171.1:8001/v1",
        "apiKey": "{env:CHATBOT_AI_BEARER_TOKEN}"
      },
      "models": {
        "qwen3-opencode:4b": {
          "limit": { "context": 12288, "output": 2048 }
        }
      }
    },

    "internal-vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Internal AI - vLLM",
      "options": {
        "baseURL": "http://192.168.171.1:8002/v1",
        "apiKey": "{env:CHATBOT_AI_BEARER_TOKEN}"
      },
      "models": {
        "cyankiwi/Qwen3-4B-Instruct-2507-AWQ-4bit": {
          "limit": { "context": 12288, "output": 2048 }
        }
      }
    }
  },

  "model": "internal-ollama/qwen3-opencode:4b",
  "default_agent": "build",
  "compaction": { "auto": true }
}
