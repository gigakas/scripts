CHATBOT_AI_HOST=127.0.0.1
CHATBOT_AI_PORT=8001
CHATBOT_AI_PROVIDER=ollama
CHATBOT_AI_BEARER_TOKEN=
OLLAMA_BASE_URL=http://127.0.0.1:11434
VLLM_BASE_URL=http://127.0.0.1:8000/v1
# Endpoints vLLM adicionales (separados por coma) para servir varios modelos a la vez.
# El endpoint a usar se elige automaticamente segun el "model" pedido en /analyze o /rag/*.
# Ejemplo: VLLM_EXTRA_BASE_URLS=http://127.0.0.1:8010/v1,http://127.0.0.1:8020/v1
VLLM_EXTRA_BASE_URLS=
EMBEDDING_PROVIDER=ollama
# Ventana de contexto por defecto para /analyze via Ollama (num_ctx), si el
# caller no la especifica en "options". Ollama por defecto usa solo 2048-4096,
# lo que puede fallar con prompts largos (historial + RAG). Se puede
# sobreescribir por request mandando "options": {"num_ctx": N}.
OLLAMA_DEFAULT_NUM_CTX=8192
REQUEST_TIMEOUT=90
EMBEDDING_MODEL=nomic-embed-text
CHROMA_PERSIST_DIR=/opt/chatbot-ai-runtime/data/chroma
